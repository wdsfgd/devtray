import { Theme } from "theme.slint";
import { TaskItem, TaskCard } from "task_card.slint";
import { LogViewer } from "log_viewer.slint";
import { TaskDialog } from "task_dialog.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { ScrollView } from "std-widgets.slint";
import { I18nData } from "i18n.slint";

export { TaskItem, Theme, I18nData }

export component MainWindow inherits Window {
    title: "DevTray";
    min-width: 380px;
    min-height: 480px;
    preferred-width: 440px;
    preferred-height: 580px;
    background: Theme.background;

    // Model properties
    in property <[TaskItem]> tasks: [];
    in property <int> running_count: 0;
    in property <I18nData> tr;

    // Log viewer properties
    in-out property <string> log_viewer_text: "";
    in-out property <string> log_viewer_task_name: "";
    in-out property <bool> log_viewer_open: false;

    // Task dialog properties
    in-out property <bool> task_dialog_open: false;
    in-out property <bool> task_dialog_is_edit: false;
    in-out property <string> task_dialog_id: "";
    in-out property <string> task_dialog_name: "";
    in-out property <string> task_dialog_command: "";
    in-out property <string> task_dialog_working_dir: ".";
    in-out property <string> task_dialog_group: "";
    in-out property <string> task_dialog_stop_command: "";
    in-out property <string> task_dialog_error: "";
    in property <[string]> available_groups: [];

    // Delete confirmation dialog properties
    in-out property <bool> delete_dialog_open: false;
    in-out property <string> delete_task_id: "";
    in-out property <string> delete_task_name: "";

    // Quit confirmation dialog properties
    in-out property <bool> quit_dialog_open: false;

    // Callbacks exposed to Rust
    callback toggle_language();
    callback toggle_task(string /* task_id */);
    callback show_logs(string /* task_id */, string /* task_name */);
    callback edit_task(string /* task_id */);
    callback open_add_task();
    callback delete_task(string /* task_id */);
    callback move_task(string /* task_id */, int /* direction */);
    callback save_task(string /* id */, string /* name */, string /* command */, string /* working_dir */, string /* group */, string /* stop_command */);
    callback confirm_delete_task(string /* id */);
    callback start_all();
    callback stop_all();
    callback quit_app();
    callback clear_logs();
    callback copy_logs();

    // Main layout
    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Top Header
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            // App Title & Status Badge
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "DevTray";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }

                if root.running_count > 0 : Rectangle {
                    height: 20px;
                    background: Theme.card-bg;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 10px;
                    y: 4px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.running;
                            y: 7px;
                        }

                        Text {
                            text: root.running_count + root.tr.active_suffix;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.running;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Header Actions (Language Switcher & New Task)
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Language Switcher Button
                Rectangle {
                    width: 36px;
                    height: 28px;
                    background: btnLangTouch.pressed ? Theme.accent-pressed : (btnLangTouch.has-hover ? Theme.accent-hover : Theme.accent);
                    border-color: Theme.accent-border;
                    border-width: 1px;
                    border-radius: 6px;

                    btnLangTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle_language();
                        }
                    }

                    Text {
                        text: root.tr.lang_switch_label;
                        color: Theme.text-primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // + New Task Button
                Rectangle {
                    width: 90px;
                    height: 28px;
                    background: btnAddTouch.pressed ? Theme.accent-pressed : (btnAddTouch.has-hover ? Theme.accent-hover : Theme.accent);
                    border-color: Theme.accent-border;
                    border-width: 1px;
                    border-radius: 6px;

                    btnAddTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.task_dialog_id = "";
                            root.task_dialog_name = "";
                            root.task_dialog_command = "";
                            root.task_dialog_working_dir = ".";
                            root.task_dialog_group = "";
                            root.task_dialog_stop_command = "";
                            root.task_dialog_error = "";
                            root.task_dialog_is_edit = false;
                            root.task_dialog_open = true;
                            root.open_add_task();
                        }
                    }

                    Text {
                        text: root.tr.new_task;
                        color: Theme.accent-text;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Task List Container
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Empty State
            if root.tasks.length == 0 : VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: root.tr.no_tasks;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.tr.no_tasks_hint;
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }

            // Scrollable Task List
            if root.tasks.length > 0 : ScrollView {
                VerticalLayout {
                    spacing: 6px;
                    padding-right: 4px;

                    for task[idx] in root.tasks : VerticalLayout {
                        spacing: 6px;

                        // Section Header
                        if idx == 0 || root.tasks[idx - 1].group != task.group : Rectangle {
                            height: 24px;
                            background: transparent;

                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;

                                Text {
                                    text: task.group != "" ? task.group : root.tr.uncategorized;
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: bottom;
                                }
                            }
                        }

                        TaskCard {
                            task: task;
                            tr: root.tr;
                            tr_logs: root.tr.logs;
                            tr_edit: root.tr.edit;
                            tr_del: root.tr.del;

                            toggle_task => {
                                root.toggle_task(task.id);
                            }

                            show_logs => {
                                root.log_viewer_task_name = task.name;
                                root.log_viewer_open = true;
                                root.show_logs(task.id, task.name);
                            }

                            edit_task => {
                                root.task_dialog_id = task.id;
                                root.task_dialog_name = task.name;
                                root.task_dialog_command = task.command;
                                root.task_dialog_working_dir = task.working_directory;
                                root.task_dialog_group = task.group;
                                root.task_dialog_error = "";
                                root.task_dialog_is_edit = true;
                                root.task_dialog_open = true;
                                root.edit_task(task.id);
                            }

                            delete_task => {
                                root.delete_task_id = task.id;
                                root.delete_task_name = task.name;
                                root.delete_dialog_open = true;
                            }

                            move_up => {
                                root.move_task(task.id, -1);
                            }

                            move_down => {
                                root.move_task(task.id, 1);
                            }
                        }
                    }
                }
            }
        }

        // Bottom Action Bar
        Rectangle {
            height: 38px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: center;

                // Start All Button
                Rectangle {
                    width: 86px;
                    height: 26px;
                    background: btnStartAll.pressed ? Theme.running-border : (btnStartAll.has-hover ? Theme.running-bg : transparent);
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 5px;

                    btnStartAll := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.start_all(); }
                    }

                    Text {
                        text: root.tr.start_all;
                        color: btnStartAll.has-hover ? Theme.running : Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Stop All Button
                Rectangle {
                    width: 86px;
                    height: 26px;
                    background: btnStopAll.pressed ? Theme.danger-surface : (btnStopAll.has-hover ? Theme.danger-hover-bg : transparent);
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 5px;

                    btnStopAll := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.stop_all(); }
                    }

                    Text {
                        text: root.tr.stop_all;
                        color: btnStopAll.has-hover ? Theme.danger : Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Quit Button
                Rectangle {
                    width: 52px;
                    height: 26px;
                    background: btnQuit.pressed ? Theme.accent-pressed : (btnQuit.has-hover ? Theme.card-hover : transparent);
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 5px;

                    btnQuit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.quit_dialog_open = true; }
                    }

                    Text {
                        text: root.tr.quit;
                        color: btnQuit.has-hover ? Theme.text-secondary : Theme.text-muted;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Modal Dialogs
    TaskDialog {
        tr: root.tr;
        is_open <=> root.task_dialog_open;
        is_edit: root.task_dialog_is_edit;
        task_id: root.task_dialog_id;
        name_text <=> root.task_dialog_name;
        command_text <=> root.task_dialog_command;
        working_dir_text <=> root.task_dialog_working_dir;
        group_text <=> root.task_dialog_group;
        stop_command_text <=> root.task_dialog_stop_command;
        available_groups: root.available_groups;
        error_message <=> root.task_dialog_error;

        save(id, name, cmd, dir, group, stop_cmd) => {
            root.save_task(id, name, cmd, dir, group, stop_cmd);
        }
    }

    LogViewer {
        tr: root.tr;
        is_open <=> root.log_viewer_open;
        task_name: root.log_viewer_task_name;
        log_text: root.log_viewer_text;

        copy_logs => {
            root.copy_logs();
        }

        clear_view => {
            root.clear_logs();
        }
    }

    ConfirmDialog {
        tr: root.tr;
        is_open <=> root.delete_dialog_open;
        title: root.tr.delete_task_title;
        message: root.tr.delete_confirm_prefix + root.delete_task_name + root.tr.delete_confirm_suffix;
        sub_message: root.tr.delete_task_submessage;
        confirm_text: root.tr.delete_confirm_button;
        is_destructive: true;
        context_id: root.delete_task_id;

        confirmed(id) => {
            root.confirm_delete_task(id);
        }
    }

    ConfirmDialog {
        tr: root.tr;
        is_open <=> root.quit_dialog_open;
        title: root.tr.quit_title;
        message: root.tr.quit_message;
        sub_message: root.tr.quit_submessage;
        confirm_text: root.tr.quit;
        is_destructive: true;

        confirmed(_) => {
            root.quit_app();
        }
    }
}
