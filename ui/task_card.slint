import { Theme } from "theme.slint";

export struct TaskItem {
    id: string,
    name: string,
    command: string,
    working_directory: string,
    group: string,
    is_running: bool,
    can_move_up: bool,
    can_move_down: bool,
}

export component TaskCard inherits Rectangle {
    in property <TaskItem> task;
    callback toggle_task();
    callback show_logs();
    callback edit_task();
    callback delete_task();
    callback move_up();
    callback move_down();

    property <bool> is_hovered: cardTouch.has-hover || btnToggle.has-hover || btnLogs.has-hover || btnEdit.has-hover || btnDelete.has-hover || btnUp.has-hover || btnDown.has-hover;

    height: 54px;
    background: root.is_hovered ? Theme.card-hover : Theme.card-bg;
    border-color: root.is_hovered ? Theme.border-light : Theme.border;
    border-width: 1px;
    border-radius: 6px;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    cardTouch := TouchArea {}

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        // 1. Move Up / Down Buttons (subtle chevrons)
        VerticalLayout {
            alignment: center;
            width: 14px;
            spacing: 2px;

            Rectangle {
                width: 14px;
                height: 12px;
                background: (btnUp.has-hover && root.task.can_move_up) ? #20252e : transparent;
                border-radius: 3px;

                btnUp := TouchArea {
                    enabled: root.task.can_move_up;
                    mouse-cursor: root.task.can_move_up ? pointer : default;
                    clicked => { root.move_up(); }
                }

                Text {
                    text: "▲";
                    font-size: 7px;
                    color: !root.task.can_move_up ? #1e232d : (btnUp.has-hover ? #f8fafc : (root.is_hovered ? #94a3b8 : #334155));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 14px;
                height: 12px;
                background: (btnDown.has-hover && root.task.can_move_down) ? #20252e : transparent;
                border-radius: 3px;

                btnDown := TouchArea {
                    enabled: root.task.can_move_down;
                    mouse-cursor: root.task.can_move_down ? pointer : default;
                    clicked => { root.move_down(); }
                }

                Text {
                    text: "▼";
                    font-size: 7px;
                    color: !root.task.can_move_down ? #1e232d : (btnDown.has-hover ? #f8fafc : (root.is_hovered ? #94a3b8 : #334155));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 2. Status Dot
        VerticalLayout {
            alignment: center;
            width: 7px;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.task.is_running ? #10b981 : #475569;
            }
        }

        // 3. Task Name & Command Subtitle (2-row stack)
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.task.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: root.task.command != "" ? "$ " + root.task.command : (root.task.working_directory != "" && root.task.working_directory != "." ? root.task.working_directory : "default");
                font-size: 10.5px;
                font-family: "DejaVu Sans Mono, monospace";
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        // 4. Action Toolbar (Revealed on hover) / Resting Status Tag
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 116px;
                height: 24px;

                // Resting state: subtle status indicator
                HorizontalLayout {
                    alignment: end;
                    opacity: root.is_hovered ? 0.0 : 1.0;
                    animate opacity { duration: 150ms; }

                    VerticalLayout {
                        alignment: center;
                        padding-right: 4px;

                        Text {
                            text: root.task.is_running ? "Running" : "Stopped";
                            font-size: 11px;
                            font-weight: 500;
                            color: root.task.is_running ? #34d399 : #64748b;
                        }
                    }
                }

                // Hover state: 4 compact ghost icon buttons
                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    opacity: root.is_hovered ? 1.0 : 0.0;
                    animate opacity { duration: 150ms; }

                    // Toggle Button
                    Rectangle {
                        width: 26px;
                        height: 24px;
                        background: root.task.is_running ?
                            (btnToggle.pressed ? #311316 : (btnToggle.has-hover ? #ef444418 : transparent)) :
                            (btnToggle.pressed ? #0e2417 : (btnToggle.has-hover ? #10b98118 : transparent));
                        border-color: root.task.is_running ?
                            (btnToggle.has-hover ? #631b21 : transparent) :
                            (btnToggle.has-hover ? #10b98133 : transparent);
                        border-width: 1px;
                        border-radius: 5px;

                        btnToggle := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_task(); }
                        }

                        Text {
                            text: root.task.is_running ? "⏹" : "▶";
                            font-size: 10px;
                            color: root.task.is_running ? #f87171 : #34d399;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Logs Button
                    Rectangle {
                        width: 26px;
                        height: 24px;
                        background: btnLogs.pressed ? #1c212b : (btnLogs.has-hover ? #262d3a : transparent);
                        border-color: btnLogs.has-hover ? #30394a : transparent;
                        border-width: 1px;
                        border-radius: 5px;

                        btnLogs := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_logs(); }
                        }

                        Text {
                            text: ">_";
                            font-size: 9.5px;
                            font-family: "DejaVu Sans Mono, monospace";
                            font-weight: 700;
                            color: btnLogs.has-hover ? #f8fafc : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Edit Button
                    Rectangle {
                        width: 26px;
                        height: 24px;
                        background: btnEdit.pressed ? #1c212b : (btnEdit.has-hover ? #262d3a : transparent);
                        border-color: btnEdit.has-hover ? #30394a : transparent;
                        border-width: 1px;
                        border-radius: 5px;

                        btnEdit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.edit_task(); }
                        }

                        Text {
                            text: "✎";
                            font-size: 12px;
                            color: btnEdit.has-hover ? #f8fafc : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Delete Button
                    Rectangle {
                        width: 26px;
                        height: 24px;
                        background: btnDelete.pressed ? #311316 : (btnDelete.has-hover ? #ef444418 : transparent);
                        border-color: btnDelete.has-hover ? #631b21 : transparent;
                        border-width: 1px;
                        border-radius: 5px;

                        btnDelete := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.delete_task(); }
                        }

                        Text {
                            text: "✕";
                            font-size: 11px;
                            color: btnDelete.has-hover ? #f87171 : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
