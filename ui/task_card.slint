import { Theme } from "theme.slint";
import { I18nData } from "i18n.slint";

export struct TaskItem {
    id: string,
    name: string,
    command: string,
    working_directory: string,
    group: string,
    is_running: bool,
    can_move_up: bool,
    can_move_down: bool,
}

export component TaskCard inherits Rectangle {
    in property <TaskItem> task;
    in property <I18nData> tr;
    in property <string> tr_logs: root.tr.logs != "" ? root.tr.logs : "Logs";
    in property <string> tr_edit: root.tr.edit != "" ? root.tr.edit : "Edit";
    in property <string> tr_del: root.tr.del != "" ? root.tr.del : "Del";

    callback toggle_task();
    callback show_logs();
    callback edit_task();
    callback delete_task();
    callback move_up();
    callback move_down();

    property <bool> is_hovered: cardTouch.has-hover || btnToggle.has-hover || btnLogs.has-hover || btnEdit.has-hover || btnDelete.has-hover || btnUp.has-hover || btnDown.has-hover;

    height: 54px;
    background: root.is_hovered ? Theme.card-hover : Theme.card-bg;
    border-color: root.is_hovered ? Theme.border-light : Theme.border;
    border-width: 1px;
    border-radius: 6px;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    cardTouch := TouchArea {}

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        // 1. Move Up / Down Buttons (subtle chevrons)
        VerticalLayout {
            alignment: center;
            width: 14px;
            spacing: 2px;

            Rectangle {
                width: 14px;
                height: 12px;
                background: (btnUp.has-hover && root.task.can_move_up) ? Theme.border : transparent;
                border-radius: 3px;

                btnUp := TouchArea {
                    enabled: root.task.can_move_up;
                    mouse-cursor: root.task.can_move_up ? pointer : default;
                    clicked => { root.move_up(); }
                }

                Text {
                    text: "▲";
                    font-size: 7px;
                    color: !root.task.can_move_up ? Theme.terminal-border : (btnUp.has-hover ? Theme.text-primary : (root.is_hovered ? Theme.text-secondary : Theme.stopped));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 14px;
                height: 12px;
                background: (btnDown.has-hover && root.task.can_move_down) ? Theme.border : transparent;
                border-radius: 3px;

                btnDown := TouchArea {
                    enabled: root.task.can_move_down;
                    mouse-cursor: root.task.can_move_down ? pointer : default;
                    clicked => { root.move_down(); }
                }

                Text {
                    text: "▼";
                    font-size: 7px;
                    color: !root.task.can_move_down ? Theme.terminal-border : (btnDown.has-hover ? Theme.text-primary : (root.is_hovered ? Theme.text-secondary : Theme.stopped));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 2. Status Dot
        VerticalLayout {
            alignment: center;
            width: 7px;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.task.is_running ? Theme.running : Theme.stopped;
            }
        }

        // 3. Task Name & Command Subtitle (2-row stack)
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.task.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: root.task.command != "" ? "$ " + root.task.command : (root.task.working_directory != "" && root.task.working_directory != "." ? root.task.working_directory : "default");
                font-size: 10.5px;
                font-family: "DejaVu Sans Mono, monospace";
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        // 4. Action Toolbar: Hover text buttons + Permanent Start/Stop Toggle Button
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                // Hover-revealed text action buttons (Logs, Edit, Del)
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    opacity: root.is_hovered ? 1.0 : 0.0;
                    animate opacity { duration: 150ms; }

                    // Logs Button
                    Rectangle {
                        height: 26px;
                        background: btnLogs.pressed ? Theme.accent-pressed : (btnLogs.has-hover ? Theme.accent : transparent);
                        border-color: btnLogs.has-hover ? Theme.accent-border : Theme.border;
                        border-width: 1px;
                        border-radius: 5px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;

                            Text {
                                text: root.tr_logs;
                                font-size: 11px;
                                font-weight: 500;
                                color: btnLogs.has-hover ? Theme.text-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        btnLogs := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_logs(); }
                        }
                    }

                    // Edit Button
                    Rectangle {
                        height: 26px;
                        background: btnEdit.pressed ? Theme.accent-pressed : (btnEdit.has-hover ? Theme.accent : transparent);
                        border-color: btnEdit.has-hover ? Theme.accent-border : Theme.border;
                        border-width: 1px;
                        border-radius: 5px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;

                            Text {
                                text: root.tr_edit;
                                font-size: 11px;
                                font-weight: 500;
                                color: btnEdit.has-hover ? Theme.text-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        btnEdit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.edit_task(); }
                        }
                    }

                    // Delete Button
                    Rectangle {
                        height: 26px;
                        background: btnDelete.pressed ? Theme.danger-surface : (btnDelete.has-hover ? Theme.danger-hover-bg : transparent);
                        border-color: btnDelete.has-hover ? Theme.danger-border : Theme.border;
                        border-width: 1px;
                        border-radius: 5px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;

                            Text {
                                text: root.tr_del;
                                font-size: 11px;
                                font-weight: 500;
                                color: btnDelete.has-hover ? Theme.danger : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        btnDelete := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.delete_task(); }
                        }
                    }
                }

                // Permanent Start/Stop Toggle Button
                Rectangle {
                    width: 28px;
                    height: 26px;
                    background: root.task.is_running ?
                        (btnToggle.pressed ? #251012 : (btnToggle.has-hover ? Theme.danger-hover-bg : Theme.danger-surface)) :
                        (btnToggle.pressed ? #0e2417 : (btnToggle.has-hover ? Theme.running-bg : #121815));
                    border-color: root.task.is_running ?
                        Theme.danger-border :
                        (btnToggle.has-hover ? Theme.running : Theme.running-border);
                    border-width: 1px;
                    border-radius: 5px;

                    btnToggle := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_task(); }
                    }

                    Text {
                        text: root.task.is_running ? "⏹" : "▶";
                        font-size: 10px;
                        color: root.task.is_running ? Theme.danger : Theme.running;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
