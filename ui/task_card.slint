import { Theme } from "theme.slint";

export struct TaskItem {
    id: string,
    name: string,
    command: string,
    working_directory: string,
    group: string,
    is_running: bool,
    can_move_up: bool,
    can_move_down: bool,
}

export component TaskCard inherits Rectangle {
    in property <TaskItem> task;
    callback toggle_task();
    callback show_logs();
    callback edit_task();
    callback delete_task();
    callback move_up();
    callback move_down();

    height: 50px;
    background: cardTouch.has-hover ? Theme.card-hover : Theme.card-bg;
    border-color: cardTouch.has-hover ? Theme.border-light : Theme.border;
    border-width: 1px;
    border-radius: 6px;

    cardTouch := TouchArea {}

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: center;

        // Move Up / Down Buttons
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            width: 18px;

            Rectangle {
                width: 18px;
                height: 15px;
                background: (btnUp.has-hover && root.task.can_move_up) ? #3a3a3a : transparent;
                border-radius: 3px;

                btnUp := TouchArea {
                    enabled: root.task.can_move_up;
                    mouse-cursor: root.task.can_move_up ? pointer : default;
                    clicked => { root.move_up(); }
                }

                Text {
                    text: "▲";
                    font-size: 9px;
                    color: root.task.can_move_up ? (btnUp.has-hover ? #ffffff : #888888) : #404040;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 18px;
                height: 15px;
                background: (btnDown.has-hover && root.task.can_move_down) ? #3a3a3a : transparent;
                border-radius: 3px;

                btnDown := TouchArea {
                    enabled: root.task.can_move_down;
                    mouse-cursor: root.task.can_move_down ? pointer : default;
                    clicked => { root.move_down(); }
                }

                Text {
                    text: "▼";
                    font-size: 9px;
                    color: root.task.can_move_down ? (btnDown.has-hover ? #ffffff : #888888) : #404040;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Status Indicator Dot with aligned centering and glow
        Rectangle {
            width: 16px;
            height: 16px;

            // Outer glow when running
            if root.task.is_running : Rectangle {
                x: 1px;
                y: 1px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: Theme.running;
                opacity: 0.35;
            }

            // Core status dot
            Rectangle {
                x: 3px;
                y: 3px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.task.is_running ? Theme.running : Theme.stopped;
            }
        }

        // Task Name & Subtitle Info
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.task.name;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: root.task.working_directory != "" && root.task.working_directory != "." ? root.task.working_directory : root.task.command;
                font-size: 11px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        // Action Buttons
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            // Start/Stop Toggle Button
            Rectangle {
                width: 32px;
                height: 28px;
                background: root.task.is_running ?
                    (btnToggle.pressed ? #2d1616 : (btnToggle.has-hover ? #401f1f : #331919)) :
                    (btnToggle.pressed ? #122919 : (btnToggle.has-hover ? #1a3d25 : #163320));
                border-color: root.task.is_running ? Theme.stopped-border : Theme.running-border;
                border-width: 1px;
                border-radius: 5px;

                btnToggle := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle_task(); }
                }

                Text {
                    text: root.task.is_running ? "⏹" : "▶";
                    font-size: 11px;
                    color: root.task.is_running ? #ff6b6b : Theme.running;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Logs Button
            Rectangle {
                width: 44px;
                height: 28px;
                background: btnLogs.pressed ? #1f1f1f : (btnLogs.has-hover ? #383838 : #2b2b2b);
                border-color: btnLogs.has-hover ? #555555 : #3f3f3f;
                border-width: 1px;
                border-radius: 5px;

                btnLogs := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show_logs(); }
                }

                Text {
                    text: "Logs";
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Edit Button
            Rectangle {
                width: 40px;
                height: 28px;
                background: btnEdit.pressed ? #1f1f1f : (btnEdit.has-hover ? #383838 : #2b2b2b);
                border-color: btnEdit.has-hover ? #555555 : #3f3f3f;
                border-width: 1px;
                border-radius: 5px;

                btnEdit := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit_task(); }
                }

                Text {
                    text: "Edit";
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Delete Button
            Rectangle {
                width: 48px;
                height: 28px;
                background: btnDelete.pressed ? #3d1a1a : (btnDelete.has-hover ? #4d2020 : #2b2b2b);
                border-color: btnDelete.has-hover ? #883333 : #3f3f3f;
                border-width: 1px;
                border-radius: 5px;

                btnDelete := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.delete_task(); }
                }

                Text {
                    text: "Delete";
                    font-size: 11px;
                    font-weight: 500;
                    color: btnDelete.has-hover ? #ff7777 : Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
