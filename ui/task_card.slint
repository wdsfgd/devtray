import { Theme } from "theme.slint";

export struct TaskItem {
    id: string,
    name: string,
    command: string,
    working_directory: string,
    group: string,
    is_running: bool,
    can_move_up: bool,
    can_move_down: bool,
}

export component TaskCard inherits Rectangle {
    in property <TaskItem> task;
    callback toggle_task();
    callback show_logs();
    callback edit_task();
    callback delete_task();
    callback move_up();
    callback move_down();

    height: 52px;
    background: cardTouch.has-hover ? Theme.card-hover : Theme.card-bg;
    border-color: cardTouch.has-hover ? Theme.border-light : Theme.border;
    border-width: 1px;
    border-radius: 8px;

    cardTouch := TouchArea {}

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // 1. Move Up / Down Buttons (strictly centered)
        VerticalLayout {
            alignment: center;
            width: 16px;
            spacing: 3px;

            Rectangle {
                width: 16px;
                height: 14px;
                background: (btnUp.has-hover && root.task.can_move_up) ? #3a3a3a : transparent;
                border-radius: 3px;

                btnUp := TouchArea {
                    enabled: root.task.can_move_up;
                    mouse-cursor: root.task.can_move_up ? pointer : default;
                    clicked => { root.move_up(); }
                }

                Text {
                    text: "▲";
                    font-size: 8px;
                    color: root.task.can_move_up ? (btnUp.has-hover ? #ffffff : #888888) : #3a3a3a;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 16px;
                height: 14px;
                background: (btnDown.has-hover && root.task.can_move_down) ? #3a3a3a : transparent;
                border-radius: 3px;

                btnDown := TouchArea {
                    enabled: root.task.can_move_down;
                    mouse-cursor: root.task.can_move_down ? pointer : default;
                    clicked => { root.move_down(); }
                }

                Text {
                    text: "▼";
                    font-size: 8px;
                    color: root.task.can_move_down ? (btnDown.has-hover ? #ffffff : #888888) : #3a3a3a;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 2. Status Dot (strictly centered)
        VerticalLayout {
            alignment: center;
            width: 12px;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.task.is_running ? Theme.running : Theme.stopped;
            }
        }

        // 3. Task Name & Subtitle (strictly centered vertically)
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.task.name;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }

            if root.task.working_directory != "" && root.task.working_directory != "." : Text {
                text: root.task.working_directory;
                font-size: 11px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        // 4. Action Buttons (strictly centered)
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // Start/Stop Toggle
                Rectangle {
                    width: 32px;
                    height: 28px;
                    background: root.task.is_running ?
                        (btnToggle.pressed ? #2d1616 : (btnToggle.has-hover ? #3d1c1c : #301717)) :
                        (btnToggle.pressed ? #122919 : (btnToggle.has-hover ? #1a3d25 : #15301e));
                    border-color: root.task.is_running ? Theme.stopped-border : Theme.running-border;
                    border-width: 1px;
                    border-radius: 5px;

                    btnToggle := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_task(); }
                    }

                    Text {
                        text: root.task.is_running ? "⏹" : "▶";
                        font-size: 11px;
                        color: root.task.is_running ? #ff6b6b : Theme.running;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Logs
                Rectangle {
                    width: 44px;
                    height: 28px;
                    background: btnLogs.pressed ? #1e1e1e : (btnLogs.has-hover ? #383838 : #2c2c2c);
                    border-color: btnLogs.has-hover ? #555555 : #3d3d3d;
                    border-width: 1px;
                    border-radius: 5px;

                    btnLogs := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show_logs(); }
                    }

                    Text {
                        text: "Logs";
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Edit
                Rectangle {
                    width: 40px;
                    height: 28px;
                    background: btnEdit.pressed ? #1e1e1e : (btnEdit.has-hover ? #383838 : #2c2c2c);
                    border-color: btnEdit.has-hover ? #555555 : #3d3d3d;
                    border-width: 1px;
                    border-radius: 5px;

                    btnEdit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit_task(); }
                    }

                    Text {
                        text: "Edit";
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Delete
                Rectangle {
                    width: 48px;
                    height: 28px;
                    background: btnDelete.pressed ? #3d1a1a : (btnDelete.has-hover ? #4d2020 : #2c2c2c);
                    border-color: btnDelete.has-hover ? #883333 : #3d3d3d;
                    border-width: 1px;
                    border-radius: 5px;

                    btnDelete := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.delete_task(); }
                    }

                    Text {
                        text: "Delete";
                        font-size: 11px;
                        font-weight: 500;
                        color: btnDelete.has-hover ? #ff7777 : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
