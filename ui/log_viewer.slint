import { Theme } from "theme.slint";
import { LineEdit, TextEdit } from "std-widgets.slint";
import { I18nData } from "i18n.slint";

export component LogViewer inherits Rectangle {
    in property <I18nData> tr;
    in-out property <bool> is_open: false;
    in property <string> task_name: "";
    in property <string> log_text: "";
    in-out property <string> search_query: "";
    in property <int> match_count: 0;
    in property <int> match_index: 0;
    callback search(string);
    callback find_next();
    callback find_prev();
    callback copy_logs();
    callback clear_view();
    callback close();

    public function set_selection(start: int, end: int) {
        logTextEdit.set-selection-offsets(start, end);
    }

    visible: root.is_open;
    z: 100;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    background: Theme.modal-backdrop;

    // Intercept clicks on backdrop
    TouchArea {}

    // Modal Dialog Box
    dialog_box := Rectangle {
        width: min(root.width - 24px, 560px);
        height: min(root.height - 30px, 440px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.card-bg;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: 10px;
        clip: true;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Header
            HorizontalLayout {
                height: 24px;
                alignment: space-between;

                Text {
                    text: root.tr.logs_title_prefix + (root.task_name != "" ? root.task_name : "Task");
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: closeBtnTouch.has-hover ? Theme.accent : transparent;

                    closeBtnTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                            root.is_open = false;
                        }
                    }

                    Text {
                        text: "✕";
                        color: closeBtnTouch.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Find / Search Toolbar
            HorizontalLayout {
                height: 28px;
                spacing: 8px;

                search_input := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: root.tr.search_logs;
                    text <=> root.search_query;
                    edited(val) => {
                        root.search(val);
                    }
                    accepted => {
                        root.find_next();
                    }
                }

                // Match counter indicator
                Rectangle {
                    min-width: 60px;
                    horizontal-stretch: 0;
                    background: transparent;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.search_query == "" ? "" : (root.match_count > 0 ? (root.match_index + 1) + "/" + root.match_count : root.tr.no_matches);
                            color: root.match_count > 0 ? Theme.text-secondary : Theme.danger;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Prev Button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: prevBtnTouch.has-hover ? Theme.accent-hover : Theme.accent;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 6px;

                    prevBtnTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.find_prev();
                        }
                    }

                    Text {
                        text: "▲";
                        color: prevBtnTouch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Next Button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: nextBtnTouch.has-hover ? Theme.accent-hover : Theme.accent;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 6px;

                    nextBtnTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.find_next();
                        }
                    }

                    Text {
                        text: "▼";
                        color: nextBtnTouch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Terminal Log Box
            Rectangle {
                vertical-stretch: 1;
                background: Theme.terminal-bg;
                border-color: Theme.terminal-border;
                border-width: 1px;
                border-radius: 6px;
                clip: true;

                logTextEdit := TextEdit {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    read-only: true;
                    text: root.log_text;
                    font-family: "DejaVu Sans Mono, monospace";
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if root.log_text == "" : Text {
                    text: root.tr.no_logs_recorded;
                    color: Theme.text-muted;
                    font-size: 11px;
                    font-italic: true;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Action Toolbar
            HorizontalLayout {
                height: 28px;
                spacing: 8px;

                // Copy Logs Button
                Rectangle {
                    width: 78px;
                    height: 28px;
                    background: copyBtnTouch.pressed ? Theme.accent-pressed : (copyBtnTouch.has-hover ? Theme.accent : transparent);
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 6px;

                    copyBtnTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy_logs(); }
                    }

                    Text {
                        text: root.tr.copy_logs;
                        color: copyBtnTouch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Clear View Button
                Rectangle {
                    width: 80px;
                    height: 28px;
                    background: clearBtnTouch.pressed ? Theme.danger-surface : (clearBtnTouch.has-hover ? Theme.danger-hover-bg : transparent);
                    border-color: clearBtnTouch.has-hover ? Theme.danger-border : Theme.border;
                    border-width: 1px;
                    border-radius: 6px;

                    clearBtnTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clear_view(); }
                    }

                    Text {
                        text: root.tr.clear_view;
                        color: clearBtnTouch.has-hover ? Theme.danger : Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Close Button
                Rectangle {
                    width: 64px;
                    height: 28px;
                    background: closeActionTouch.pressed ? Theme.accent-pressed : (closeActionTouch.has-hover ? Theme.accent : transparent);
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 6px;

                    closeActionTouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                            root.is_open = false;
                        }
                    }

                    Text {
                        text: root.tr.close;
                        color: closeActionTouch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
