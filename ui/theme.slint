export global Theme {
    // Window & Surfaces
    out property <color> background: #191919;
    out property <color> surface: #222222;
    out property <color> card-bg: #262626;
    out property <color> card-hover: #2f2f2f;
    out property <color> border: #363636;
    out property <color> border-light: #444444;
    out property <color> input-bg: #1c1c1c;

    // Typography
    out property <color> text-primary: #ffffff;
    out property <color> text-secondary: #dcdcdc;
    out property <color> text-muted: #888888;

    // Accents & Actions
    out property <color> accent: #3584e4;
    out property <color> accent-hover: #4a90e8;
    out property <color> accent-pressed: #286bc4;

    // Status
    out property <color> running: #2ecc71;
    out property <color> running-bg: #163520;
    out property <color> running-border: #27ae60;
    out property <color> stopped: #e74c3c;
    out property <color> stopped-bg: #351a1a;
    out property <color> stopped-border: #c0392b;

    // Danger / Destructive
    out property <color> danger: #e74c3c;
    out property <color> danger-hover: #c0392b;
    out property <color> danger-pressed: #962d22;

    // Terminal
    out property <color> terminal-bg: #121212;
    out property <color> terminal-text: #33d17a;

    // Modals
    out property <color> modal-backdrop: #000000c0;
}
